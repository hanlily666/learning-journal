# Copy to .env and fill in. Never commit .env.

# Your own Anthropic API key (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# A direct Postgres connection (not Supabase's REST API).
# Local Docker (docker compose up -d):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_journal
# Supabase: Project Settings -> Database -> Connection string -> "Direct connection", e.g.
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# Optional settings (defaults shown).
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# REPLY_MAX_TOKENS=64000
# CONTEXT_WARNING_TOKENS=150000
# WEB_ORIGIN=http://localhost:5173

# Backups (scripts/backup.sh). The folder must be private, e.g. outside any synced/shared folder.
# BACKUP_DIR=/Users/you/learning-journal-backups
# Optional: delete dumps older than this many days (unset keeps every dump).
# BACKUP_KEEP_DAYS=30
